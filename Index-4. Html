<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Brawl Arena</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none}
body{margin:0;font-family:Arial Black,Arial,sans-serif;background:linear-gradient(135deg,#1e90ff,#2ecc71);min-height:100vh;color:#fff;overflow:hidden}
.screen{display:none;padding:20px;text-align:center;min-height:100vh}
.screen.on{display:block}
h1{font-size:34px;text-shadow:3px 3px 0 #000;margin:10px 0}
button,select,input{font-family:inherit;font-size:18px;border-radius:12px;border:3px solid #000;padding:12px 18px;margin:8px}
button{background:#ffd200;color:#000;cursor:pointer;box-shadow:0 4px 0 #000}
button:active{transform:translateY(3px);box-shadow:0 1px 0 #000}
.big{font-size:24px;padding:16px 28px}
.card{background:rgba(0,0,0,.35);border-radius:16px;padding:16px;margin:12px auto;max-width:420px}
label{display:block;margin-top:10px;text-align:left}
input[type=range]{width:100%}
#gear{position:fixed;top:10px;right:10px;z-index:20;font-size:26px;padding:6px 12px;margin:0}
#settings{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.75);z-index:30;display:none;align-items:center;justify-content:center}
#settings.on{display:flex}
#settings .card{background:#1b3a6b;border:4px solid #000;width:90%}
.row{display:flex;justify-content:space-between;align-items:center;margin:10px 0}
#game{display:block;background:#8b5a6b;touch-action:none;width:100vw;height:100vh}
#hud{position:fixed;top:8px;left:8px;z-index:5;display:flex;gap:10px;align-items:center}
#hud button{padding:6px 12px;font-size:14px;margin:0}
#hpbar{font-size:18px;text-shadow:2px 2px 0 #000}
#joy{position:fixed;left:25px;bottom:25px;width:130px;height:130px;border-radius:50%;background:rgba(0,80,255,.35);border:3px solid #fff;z-index:5;touch-action:none}
#stick{position:absolute;left:35px;top:35px;width:60px;height:60px;border-radius:50%;background:#1e5bff;border:3px solid #fff}
#atk{position:fixed;right:30px;bottom:40px;width:100px;height:100px;border-radius:50%;background:#e74c3c;border:4px solid #fff;font-size:15px;z-index:5;color:#fff;margin:0;padding:0}
#boss{position:fixed;right:30px;bottom:160px;z-index:5;font-size:14px;padding:8px 12px;margin:0}
</style>
</head>
<body>

<button id="gear" onclick="toggleSet(true)">&#9881;</button>

<div id="settings">
<div class="card">
<h1 id="t-set">Impostazioni</h1>
<div class="row"><span id="t-lang">Lingua</span>
<select id="lang" onchange="setLang(this.value)">
<option value="it">Italiano</option>
<option value="en">English</option>
<option value="es">Español</option>
<option value="fr">Français</option>
<option value="de">Deutsch</option>
</select></div>
<div class="row"><span id="t-music">Musica</span><input type="checkbox" id="chkMusic" checked onchange="setMusic(this.checked)" style="width:28px;height:28px"></div>
<div class="row"><span id="t-sfx">Effetti sonori</span><input type="checkbox" id="chkSfx" checked onchange="sfxOn=this.checked" style="width:28px;height:28px"></div>
<div class="row"><span id="t-help">Assistenza</span><button onclick="alert(TX[lang].helptxt)">?</button></div>
<button class="big" id="t-close" onclick="toggleSet(false)">Chiudi</button>
</div>
</div>

<div id="s-login" class="screen on">
<h1 id="t-title">Brawl Arena</h1>
<div class="card"><input id="user" placeholder="Nome utente" maxlength="14"></div>
<button class="big" id="t-enter" onclick="enter()">Entra</button>
</div>

<div id="s-home" class="screen">
<h1 id="t-hello"></h1>
<div class="card"><div id="cur" style="font-size:60px">&#129354;</div><div id="curname"></div></div>
<button class="big" id="t-create" onclick="show('s-create')">Crea il tuo brawler</button><br>
<button class="big" id="t-play" onclick="startGame()">Campo di prova</button>
</div>

<div id="s-create" class="screen">
<h1 id="t-cb">Crea il tuo brawler</h1>
<div class="card">
<input id="bname" placeholder="Nome" maxlength="12">
<label><span id="t-col">Colore</span> <input type="color" id="bcol" value="#ffd200" style="width:60px;padding:2px"></label>
<label><span id="t-hp">Vita</span>: <b id="vhp">5000</b><input type="range" id="bhp" min="2000" max="10000" step="100" value="5000"></label>
<label><span id="t-dmg">Danno</span>: <b id="vdmg">400</b><input type="range" id="bdmg" min="100" max="1500" step="50" value="400"></label>
<label><span id="t-spd">Velocità</span>: <b id="vspd">3</b><input type="range" id="bspd" min="1" max="6" step="0.5" value="3"></label>
</div>
<button class="big" id="t-save" onclick="saveBrawler()">Salva</button>
</div>

<div id="s-game" class="screen" style="padding:0">
<div id="hud"><button onclick="stopGame()">&#11013;</button><div id="hpbar"></div></div>
<canvas id="game"></canvas>
<div id="joy"><div id="stick"></div></div>
<button id="atk" onclick="attack()">ATTACK</button>
<button id="boss" onclick="spawnBoss()">BOSS</button>
</div>

<script>
var TX={
it:{title:'Brawl Arena',enter:'Entra',hello:'Ciao',create:'Crea il tuo brawler',play:'Campo di prova',cb:'Crea il tuo brawler',col:'Colore',hp:'Vita',dmg:'Danno',spd:'Velocità',save:'Salva',name:'Nome',user:'Nome utente',set:'Impostazioni',lang:'Lingua',music:'Musica',sfx:'Effetti sonori',help:'Assistenza',close:'Chiudi',helptxt:'Per assistenza scrivici: inserisci qui la tua email.'},
en:{title:'Brawl Arena',enter:'Enter',hello:'Hello',create:'Create your brawler',play:'Training ground',cb:'Create your brawler',col:'Color',hp:'Health',dmg:'Damage',spd:'Speed',save:'Save',name:'Name',user:'Username',set:'Settings',lang:'Language',music:'Music',sfx:'Sound effects',help:'Support',close:'Close',helptxt:'For support write to us: put your email here.'},
es:{title:'Brawl Arena',enter:'Entrar',hello:'Hola',create:'Crea tu brawler',play:'Campo de pruebas',cb:'Crea tu brawler',col:'Color',hp:'Vida',dmg:'Daño',spd:'Velocidad',save:'Guardar',name:'Nombre',user:'Usuario',set:'Ajustes',lang:'Idioma',music:'Música',sfx:'Efectos de sonido',help:'Ayuda',close:'Cerrar',helptxt:'Para ayuda escríbenos: pon aquí tu email.'},
fr:{title:'Brawl Arena',enter:'Entrer',hello:'Salut',create:'Crée ton brawler',play:'Terrain d\'essai',cb:'Crée ton brawler',col:'Couleur',hp:'Vie',dmg:'Dégâts',spd:'Vitesse',save:'Sauvegarder',name:'Nom',user:'Pseudo',set:'Paramètres',lang:'Langue',music:'Musique',sfx:'Effets sonores',help:'Assistance',close:'Fermer',helptxt:'Pour l\'assistance écris-nous : mets ici ton email.'},
de:{title:'Brawl Arena',enter:'Los',hello:'Hallo',create:'Erstelle deinen Brawler',play:'Testgelände',cb:'Erstelle deinen Brawler',col:'Farbe',hp:'Leben',dmg:'Schaden',spd:'Tempo',save:'Speichern',name:'Name',user:'Benutzername',set:'Einstellungen',lang:'Sprache',music:'Musik',sfx:'Soundeffekte',help:'Hilfe',close:'Schließen',helptxt:'Für Hilfe schreib uns: trage hier deine E-Mail ein.'}
};
var lang='it',me={name:'Player'},B={name:'Multi',col:'#ffd200',hp:5000,dmg:400,spd:3};
function $(i){return document.getElementById(i)}
function show(id){var s=document.getElementsByClassName('screen');for(var i=0;i<s.length;i++)s[i].classList.remove('on');$(id).classList.add('on')}
function toggleSet(v){$('settings').classList.toggle('on',v)}
function setLang(l){lang=l;var t=TX[l];var m={'t-title':'title','t-enter':'enter','t-create':'create','t-play':'play','t-cb':'cb','t-col':'col','t-hp':'hp','t-dmg':'dmg','t-spd':'spd','t-save':'save','t-set':'set','t-lang':'lang','t-music':'music','t-sfx':'sfx','t-help':'help','t-close':'close'};for(var k in m){$(k).textContent=t[m[k]]}$('user').placeholder=t.user;$('bname').placeholder=t.name;document.documentElement.lang=l;refresh()}
function enter(){me.name=$('user').value||'Player';refresh();show('s-home');if($('chkMusic').checked)setMusic(true)}
function refresh(){$('cur').style.color=B.col;$('curname').textContent=B.name+' · '+B.hp+' HP · '+B.dmg+' DMG';$('t-hello').textContent=TX[lang].hello+', '+me.name+'!'}
['hp','dmg','spd'].forEach(function(k){$('b'+k).oninput=function(){$('v'+k).textContent=this.value}});
function saveBrawler(){B={name:$('bname').value||'Brawler',col:$('bcol').value,hp:+$('bhp').value,dmg:+$('bdmg').value,spd:+$('bspd').value};refresh();show('s-home')}

/* ---------- AUDIO (generato dal browser, niente file) ---------- */
var AC=null,sfxOn=true,musicTimer=null,musicOn=false;
function getAC(){if(!AC){var C=window.AudioContext||window.webkitAudioContext;if(C)AC=new C()}if(AC&&AC.state==='suspended')AC.resume();return AC}
function tone(f,d,type,vol,when){var a=getAC();if(!a)return;var o=a.createOscillator(),g=a.createGain();o.type=type||'square';o.frequency.value=f;var t=a.currentTime+(when||0);g.gain.setValueAtTime(vol||.1,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);o.connect(g);g.connect(a.destination);o.start(t);o.stop(t+d)}
function sfx(kind){if(!sfxOn)return;if(kind==='hit')tone(220,.1,'square',.12);else if(kind==='boom'){tone(80,.4,'sawtooth',.2);tone(50,.5,'sine',.2)}else if(kind==='shoot')tone(660,.08,'triangle',.1);else if(kind==='boss'){tone(110,.6,'sawtooth',.2);tone(90,.8,'square',.15,.1)}}
var NOTES=[262,330,392,330,294,370,440,370,262,330,392,523,494,392,330,294];
var ni=0;
function setMusic(on){musicOn=on;if(musicTimer){clearInterval(musicTimer);musicTimer=null}if(on){getAC();musicTimer=setInterval(function(){tone(NOTES[ni%NOTES.length],.22,'triangle',.06);if(ni%4===0)tone(NOTES[ni%NOTES.length]/2,.4,'sine',.07);ni++},260)}}

/* ---------- GIOCO ---------- */
var cv,cx,W=2400,H=1600,player,enemies,crates,grass,walls,bullets,floats,cam,keys={x:0,y:0},running=false,raf=null,lastAtk=0,aim={x:1,y:0};
function rnd(a,b){return a+Math.random()*(b-a)}
function startGame(){
 show('s-game');cv=$('game');cv.width=innerWidth;cv.height=innerHeight;cx=cv.getContext('2d');
 player={x:W/2,y:H/2,r:22,hp:B.hp,max:B.hp};
 enemies=[];crates=[];grass=[];walls=[];bullets=[];floats=[];cam={x:0,y:0};
 for(var r=0;r<3;r++)for(var c=0;c<8;c++)enemies.push({x:300+c*90,y:300+r*90,r:24,hp:4000,max:4000,boss:false,spd:.6});
 for(var i=0;i<12;i++)crates.push({x:rnd(200,W-200),y:rnd(200,H-200),r:22,hp:2500,max:2500});
 for(var i=0;i<14;i++)grass.push({x:rnd(100,W-300),y:rnd(100,H-300),w:rnd(140,260),h:rnd(120,220)});
 for(var i=0;i<10;i++)walls.push({x:rnd(100,W-200),y:rnd(100,H-200),w:rnd(30,50),h:rnd(120,260)});
 running=true;loop()
}
function stopGame(){running=false;cancelAnimationFrame(raf);show('s-home')}
function spawnBoss(){sfx('boss');enemies.push({x:player.x+300,y:player.y,r:90,hp:30000,max:30000,boss:true,spd:.5})}
function attack(){
 var now=Date.now();if(now-lastAtk<250)return;lastAtk=now;sfx('shoot');
 bullets.push({x:player.x,y:player.y,vx:aim.x*12,vy:aim.y*12,life:40});
}
function dmgText(x,y,v){floats.push({x:x,y:y,v:v,t:40})}
function hitAt(b){
 for(var i=0;i<enemies.length;i++){var e=enemies[i];if(Math.hypot(e.x-b.x,e.y-b.y)<e.r+8){e.hp-=B.dmg;dmgText(e.x,e.y-e.r,B.dmg);sfx('hit');if(e.hp<=0){enemies.splice(i,1)}return true}}
 for(var j=0;j<crates.length;j++){var c=crates[j];if(Math.hypot(c.x-b.x,c.y-b.y)<c.r+8){c.hp-=B.dmg;dmgText(c.x,c.y-c.r,B.dmg);sfx('hit');if(c.hp<=0){sfx('boom');for(var k=enemies.length-1;k>=0;k--){if(Math.hypot(enemies[k].x-c.x,enemies[k].y-c.y)<160){enemies[k].hp-=1500;dmgText(enemies[k].x,enemies[k].y,1500);if(enemies[k].hp<=0)enemies.splice(k,1)}}crates.splice(j,1)}return true}}
 return false
}
function update(){
 var nx=player.x+keys.x*B.spd,ny=player.y+keys.y*B.spd;
 player.x=Math.max(20,Math.min(W-20,nx));player.y=Math.max(20,Math.min(H-20,ny));
 if(keys.x||keys.y){var l=Math.hypot(keys.x,keys.y);aim={x:keys.x/l,y:keys.y/l}}
 for(var i=bullets.length-1;i>=0;i--){var b=bullets[i];b.x+=b.vx;b.y+=b.vy;b.life--;if(b.life<=0||hitAt(b))bullets.splice(i,1)}
 enemies.forEach(function(e){var d=Math.hypot(player.x-e.x,player.y-e.y);if(d>e.r+player.r){e.x+=(player.x-e.x)/d*e.spd;e.y+=(player.y-e.y)/d*e.spd}else{player.hp-=e.boss?4:1}});
 if(player.hp<=0){player.hp=player.max}
 for(var f=floats.length-1;f>=0;f--){floats[f].t--;floats[f].y-=1;if(floats[f].t<=0)floats.splice(f,1)}
 cam.x=Math.max(0,Math.min(W-cv.width,player.x-cv.width/2));cam.y=Math.max(0,Math.min(H-cv.height,player.y-cv.height/2));
 $('hpbar').textContent=B.name+'  '+Math.max(0,Math.floor(player.hp))
}
function bar(x,y,w,hp,max,col){cx.fillStyle='#000';cx.fillRect(x-w/2-2,y-2,w+4,10);cx.fillStyle=col;cx.fillRect(x-w/2,y,w*Math.max(0,hp)/max,6)}
function draw(){
 cx.fillStyle='#8b5a6b';cx.fillRect(0,0,cv.width,cv.height);
 cx.save();cx.translate(-cam.x,-cam.y);
 cx.fillStyle='#7a4d5d';for(var gx=0;gx<W;gx+=100)for(var gy=0;gy<H;gy+=100)if((gx+gy)/100%2===0)cx.fillRect(gx,gy,100,100);
 cx.fillStyle='#e8857f';walls.forEach(function(w){cx.fillRect(w.x,w.y,w.w,w.h)});
 crates.forEach(function(c){cx.fillStyle='#c0392b';cx.fillRect(c.x-c.r,c.y-c.r,c.r*2,c.r*2);cx.fillStyle='#fff';cx.font='bold 14px Arial';cx.textAlign='center';cx.fillText('TNT',c.x,c.y+5);bar(c.x,c.y-c.r-14,44,c.hp,c.max,'#e74c3c')});
 enemies.forEach(function(e){cx.fillStyle='#ccd';cx.beginPath();cx.arc(e.x,e.y,e.r,0,7);cx.fill();cx.fillStyle='#e02020';cx.beginPath();cx.arc(e.x-e.r*.9,e.y+e.r*.3,e.r*.45,0,7);cx.arc(e.x+e.r*.9,e.y+e.r*.3,e.r*.45,0,7);cx.fill();bar(e.x,e.y-e.r-14,e.r*2,e.hp,e.max,'#e74c3c')});
 cx.fillStyle=B.col;cx.beginPath();cx.arc(player.x,player.y,player.r,0,7);cx.fill();cx.strokeStyle='#000';cx.lineWidth=3;cx.stroke();
 bar(player.x,player.y-player.r-16,60,player.hp,player.max,'#2ecc71');
 cx.fillStyle='#fff';cx.font='bold 14px Arial';cx.textAlign='center';cx.fillText(B.name,player.x,player.y-player.r-22);
 bullets.forEach(function(b){cx.fillStyle='#fff';cx.beginPath();cx.arc(b.x,b.y,7,0,7);cx.fill()});
 grass.forEach(function(g){cx.fillStyle='rgba(40,180,60,.85)';cx.fillRect(g.x,g.y,g.w,g.h)});
 cx.font='bold 22px Arial Black,Arial';floats.forEach(function(f){cx.fillStyle='#fff';cx.strokeStyle='#000';cx.lineWidth=4;cx.strokeText(f.v,f.x,f.y);cx.fillText(f.v,f.x,f.y)});
 cx.restore()
}
function loop(){if(!running)return;update();draw();raf=requestAnimationFrame(loop)}

/* ---------- JOYSTICK ---------- */
(function(){
 var j=$('joy'),s=$('stick'),act=false;
 function mv(e){var t=e.touches?e.touches[0]:e;var r=j.getBoundingClientRect();var dx=t.clientX-(r.left+r.width/2),dy=t.clientY-(r.top+r.height/2);var d=Math.min(Math.hypot(dx,dy),45);var a=Math.atan2(dy,dx);s.style.left=(35+Math.cos(a)*d)+'px';s.style.top=(35+Math.sin(a)*d)+'px';keys.x=Math.cos(a)*(d/45);keys.y=Math.sin(a)*(d/45)}
 function end(){act=false;s.style.left='35px';s.style.top='35px';keys.x=0;keys.y=0}
 j.addEventListener('touchstart',function(e){act=true;mv(e);e.preventDefault()},{passive:false});
 j.addEventListener('touchmove',function(e){if(act)mv(e);e.preventDefault()},{passive:false});
 j.addEventListener('touchend',end);
 j.addEventListener('mousedown',function(e){act=true;mv(e)});
 window.addEventListener('mousemove',function(e){if(act)mv(e)});
 window.addEventListener('mouseup',end);
})();
setLang('it');
</script>
</body>
</html>